# DAR AL JANNAH ERP configuration template.
#
# Copy this file to ".env" in the same folder as manage.py and edit the values:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / hosting server)
# ".env" is never committed to git, so each server keeps its own settings.
# Real environment variables set by the hosting panel take priority over this file.
# Restart the app after changing it.

# --- Security -----------------------------------------------------------------
# Set DEBUG=False on a live server. DEBUG=True shows technical error pages to visitors.
DEBUG=True

# REQUIRED on a live server. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Wrap it in single quotes if it contains special characters.
# SECRET_KEY='replace-me'

# --- Hosting: which domain names may serve the site ---------------------------
# Comma-separated bare domain names: no quotes, no http(s):// and no trailing slash.
# Visitors using any other name get "Bad Request (400)".
#   ALLOWED_HOSTS=erp.example.com,www.example.com
#   ALLOWED_HOSTS=.example.com          (a leading dot also allows every subdomain)
# Include the server's IP address too if you open the site by IP.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------------
# Leave unset to use the local SQLite file (db.sqlite3). Otherwise a URL, for example:
#   DATABASE_URL=sqlite:///C:/path/to/db.sqlite3
#   DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME   (needs the mysqlclient package, not in requirements.txt)
# DATABASE_URL=

# --- Sensitive screens --------------------------------------------------------
# These areas ask the signed-in user to type their password again before opening, so the
# software can be shown to buyers without exposing costs and accounts. Names are URL areas:
# costing, books, reports, sales, customers, suppliers, projects.
# Directors and the audit trail (activity_log) are always on this list, whatever is written here.
SENSITIVE_NAMESPACES=costing,books,reports
# Minutes of inactivity on those screens before they lock again.
REAUTH_MINUTES=15

# --- Features ------------------------------------------------------------------
# "Send invoice on WhatsApp" (menu item, sale-page button and list). Built but off by default.
# WHATSAPP_ENABLED=True

# --- Public address (links sent to customers) -----------------------------------
# The address customers open from a WhatsApp invoice link, with https:// and no trailing slash.
# Leave empty to use the address the staff member is browsing from.
# SITE_URL=https://erp.example.com

# --- Company (used on printed documents until a letterhead/profile is saved in the app) ---
# COMPANY_NAME=DAR AL JANNAH
COMPANY_CODE_PREFIX=AB
COMPANY_ADDRESS=
COMPANY_PHONE=

# --- Customer SMS ----------------------------------------------------------------
# A payment SMS goes to the customer on every payment received (customers can be excluded on their
# profile). Balance reminders are only sent when a user does it from SMS > Balance reminders.
# SMS_BACKEND=log       only records messages in the SMS log, sends nothing (the default).
# SMS_BACKEND=smsnetbd  really sends them through sms.net.bd. Needs SMSNETBD_API_KEY (below).
# SMS_BACKEND=zendsms   really sends them through ZendSMS. Needs the API key and sender ID further down.
# Never commit a real API key: put it in ".env" only (it is git-ignored), not in this file.
SMS_BACKEND=log

# sms.net.bd. The API key is on the "API" page of your sms.net.bd panel. The sender ID is optional: it must be an
# approved sender ID, otherwise leave it empty and the gateway's default sender is used.
# SMSNETBD_API_URL=https://api.sms.net.bd/sendsms
# SMSNETBD_BALANCE_URL=https://api.sms.net.bd/user/balance/
# SMSNETBD_API_KEY=paste-your-sms-net-bd-api-key-here
# SMSNETBD_SENDER_ID=

# ZendSMS.
# SMS_API_URL=https://api.zendsms.com/api/v1/send-sms
# SMS_BALANCE_URL=https://api.zendsms.com/api/v1/balance
# SMS_API_KEY=paste-your-zendsms-api-key-here
# SMS_SENDER_ID=your-sender-id

# --- Wording of the customer SMS ---------------------------------------------------
# Change the text here, restart the app, done. A {placeholder} is replaced with the real value; anything else is
# sent exactly as written (a mistyped {placeholder} is sent as-is, so check the SMS log after a change).
# Keep it on ONE line. Wrap it in double quotes if it contains a # sign. Long messages cost more than one SMS.
#
# Every message can use:   {customer} (with title, e.g. Mr. Rahim)  {name}  {customer_id}  {company}
# Payment and booking:     {flat}  {building}  {project}  {sale_no}  {sale_value}  {reg_value}  {net_value}
#                          {received}  {balance_due}
# Payment only:            {amount}  {date}  {receipt_no}  {total_paid}  {purpose} (Flat booking, or the installment it paid)
#                          {balance_note}  (a ready sentence: ", balance due Tk X." / "; fully paid." / "; your credit balance is Tk X.")
# Booking only:            {sale_date}
# Reminder only:           {total_due}  {details}  (each flat with what is due on it)
#
# Sent when a payment is recorded:
# SMS_TEMPLATE_PAYMENT=Dear {customer}, we received {amount} on {date} for flat {flat}, {building}. Receipt {receipt_no}. Total paid {total_paid}{balance_note} - {company}
# Sent when a flat is booked for a customer:
# SMS_TEMPLATE_BOOKING=Congratulations {customer}! Flat {flat}, {building} is now booked for you (sale {sale_no}). Sale value {sale_value}, net value {net_value}. Welcome to the family. - {company}
# Sent to every customer when an installment is issued (Sales > Installments), and when it is sent again:
# SMS_TEMPLATE_INSTALLMENT=Dear {customer}, installment {installment} of {amount} for flat {flat}, {building} is now due. Please pay by {deadline}. Total due on this flat {installment_due} - {company}
# Installment only:        {installment}  {amount}  {deadline}  {installment_due}
# Sent only when someone presses Send on SMS > Balance reminders:
# SMS_TEMPLATE_REMINDER=Dear {customer}, a friendly reminder: balance due {total_due} - {details}. Please pay at your earliest. Ignore if already paid. - {company}

# --- Automatic daily reports ------------------------------------------------------------
# manage.py generate_daily_reports writes each project's daily transactions report (PDF + Excel) and profitability analysis
# under REPORTS_DIR, and e-mails them to REPORT_RECIPIENTS (comma separated) when that is set and e-mail is configured below.
# REPORTS_DIR=generated_reports
# REPORT_RECIPIENTS=director@example.com,accounts@example.com

# --- Email (password reset). Defaults print emails to the console instead of sending. ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL='DAR AL JANNAH <noreply@example.com>'
